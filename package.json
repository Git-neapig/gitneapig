{
  "name": "gitneapig",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "env:init": "node scripts/init-env.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps packages --max-warnings 0",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:integration": "pnpm --filter @gitneapig/backend test:integration",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "db:generate": "pnpm --filter @gitneapig/backend db:generate",
    "db:migrate": "pnpm --filter @gitneapig/backend db:migrate",
    "db:seed": "pnpm --filter @gitneapig/backend db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
