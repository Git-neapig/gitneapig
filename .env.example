NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
DOCKER_APP_ORIGIN=https://localhost:8443
HTTP_PORT=8080
HTTPS_PORT=8443
TLS_HOST=localhost
APP_TIME_ZONE=Asia/Seoul
BACKEND_PORT=3000
DATABASE_URL=postgresql://gitneapig:replace-with-local-password@localhost:5432/gitneapig
TEST_DATABASE_URL=postgresql://gitneapig:replace-with-local-password@localhost:5432/gitneapig_test
POSTGRES_DB=gitneapig
POSTGRES_USER=gitneapig
POSTGRES_PASSWORD=replace-with-local-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=8h
API_KEY_HMAC_SECRET=replace-with-another-32-random-bytes
OAUTH_42_CLIENT_ID=
OAUTH_42_CLIENT_SECRET=
OAUTH_42_REDIRECT_URI=https://localhost:8443/api/v1/auth/42/callback
AVATAR_UPLOAD_DIR=./uploads/avatars
AVATAR_MAX_SIZE_MB=2
PUBLIC_API_RATE_LIMIT_MAX=60
PUBLIC_API_RATE_LIMIT_WINDOW_SECONDS=60
ONLINE_STATUS_THRESHOLD_SECONDS=120
